#!/bin/sh

set -eu

PORT="$(snapctl get port)"
BIND="$(snapctl get bind)"

#
# Validate port
#

case "$PORT" in
    ''|*[!0-9]*)
        echo "Error: port must be a number." >&2
        exit 1
        ;;
esac

if [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
    echo "Error: port must be between 1 and 65535." >&2
    exit 1
fi

#
# Validate bind address
#

if [ -z "$BIND" ]; then
    echo "Error: bind address cannot be empty." >&2
    exit 1
fi

#
# Generate runtime configuration
#

"$SNAP/bin/generate-nginx-config"

#
# Restart the service when configuration changes
#

if snapctl services hello-web | grep -q "enabled"; then
    snapctl restart hello-web
fi